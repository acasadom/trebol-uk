Trebol [
    title: "The United Kingdom: the rules of a form for postcodes and National Insurance numbers"
    exports: [postcode? ni-number?]
]

; A form that imports this package takes these rules after its fields, as it takes email:
;
;   field post "Postcode" required postcode
;
; Each one is also a function, postcode? "SW1A 1AA", for code that has no form.

digit: charset "0123456789"

; The letters each place of a postcode may have
area-first: charset "ABCDEFGHIJKLMNOPRSTUWYZ"      ; not Q, V or X
area-second: charset "ABCDEFGHKLMNOPQRSTUVWXY"     ; not I, J or Z
district-a9a: charset "ABCDEFGHJKPSTUW"            ; the letter of A9A
district-aa9a: charset "ABEHMNPRVWXY"              ; the letter of AA9A
unit: charset "ABDEFGHJLNPQRSTUWXYZ"              ; not C, I, K, M, O or V

postcode?: func [
    "True if the text is a UK postcode: SW1A 1AA, M1 1AE, B33 8TH. The space and small letters are fine."
    text [string!]
    /local s
] [
    s: uppercase trim/all copy text
    if s = "GIR0AA" [return true]
    ; the last three are always the inward code; what comes before them, the outward one
    to logic! all [
        (length? s) >= 5
        parse copy/part s (length? s) - 3 [
            area-first digit end
            | area-first digit digit end
            | area-first digit district-a9a end
            | area-first area-second digit end
            | area-first area-second digit digit end
            | area-first area-second digit district-aa9a end
        ]
        parse skip s (length? s) - 3 [digit unit unit]
    ]
]

; The letters a National Insurance number may start with
ni-first: charset "ABCEGHJKLMNOPRSTWXYZ"            ; not D, F, I, Q, U or V
ni-second: charset "ABCEGHJKLMNPRSTWXYZ"           ; nor O

ni-number?: func [
    "True if the text is a National Insurance number: two letters, six digits and A, B, C or D, as AB 12 34 56 C."
    text [string!]
    /local s
] [
    s: uppercase trim/all copy text
    to logic! all [
        parse s [ni-first ni-second 6 digit ["A" | "B" | "C" | "D"]]
        not find ["BG" "GB" "KN" "NK" "NT" "TN" "ZZ"] copy/part s 2
    ]
]

; The rules need the UI dialect; a program with no forms still has the functions.
if value? 'rule [
    rule 'postcode #(en: "Enter a valid postcode" es: "Introduce un código postal del Reino Unido") [postcode? form value]
    rule 'ni-number #(en: "Enter a valid National Insurance number" es: "Introduce un número de la Seguridad Social británica") [ni-number? form value]
]
